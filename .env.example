# LaunchFlow AI — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/launchflow

# AI — get key at: https://console.anthropic.com
# On Replit: use built-in Anthropic integration (no key needed)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Auth — generate with: openssl rand -hex 32
SESSION_SECRET=your-random-secret-here

# Server
NODE_ENV=development
PORT=3000
